---
import Logo from '../components/Logo.astro';
import Photo from '../components/Photo.astro';
import { adresseImage } from '../lib/adresse-image';
import { site, pieces } from '../data/contenu.json';
const description = 'Tailleur et denim à Lille. Pièces à la commande et sur-mesure. Le nouveau site est en préparation.';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href={`${base}/fonts/font.css`} />
    <title>Jean Laumet · Tailleur et denim, Lille</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="ePhy86WbUmTaAN4qC7_PKn9vvWHMLFboiIoDdLQdu5s" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content="Jean Laumet · Tailleur et denim, Lille" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={adresseImage(pieces[0].image.base, 960, 'jpg')} />
    <meta property="og:image:alt" content={pieces[0].image.alt} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%237d4016'/%3E%3Ctext x='32' y='43' text-anchor='middle' font-family='monospace' font-size='32' fill='%23fdfdfc'%3EJL%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <main>
      <header>
        <h1><Logo largeur="22rem" def={1600} /><span class="sr-only">Jean Laumet</span></h1>
        <p class="metier">{site.metier}</p>
      </header>
      <section class="intro" aria-label="Le nouveau site">
        <p>Le nouveau site est en préparation.</p>
        <p class="offres">Pièces à la commande et sur-mesure.</p>
        <nav aria-label="Contacter l’atelier">
          <a href={`mailto:${site.email}`}>{site.email}<span aria-hidden="true"> ↗</span></a>
          <a href={site.instagram}>Instagram<span aria-hidden="true"> ↗</span></a>
        </nav>
      </section>
      <section class="pieces" aria-label="Quelques pièces de l’atelier">
        {pieces.map((piece, i) => (
          <figure>
            <Photo image={piece.image} sizes="(min-width: 700px) 300px, calc(100vw - 40px)" eager={i === 0} />
          </figure>
        ))}
      </section>
      <footer>
        <address>{site.adresse[0]}<br />{site.adresse[1]}</address>
        <p>Pour une pièce ou un rendez-vous,<br /><a href={`mailto:${site.email}`}>écrivez-moi<span aria-hidden="true"> ↗</span></a></p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; background: oklch(99.7% 0.001 80); color: oklch(25% 0.005 60); font: 13px/1.65 'Plex', monospace; }
  * { box-sizing: border-box; }
  body, h1, p, figure { margin: 0; }
  main { max-width: 1000px; margin: 0 auto; padding: 66px 40px 30px; }
  header { display: flex; flex-direction: column; align-items: center; }
  h1 { font-size: inherit; font-weight: 400; }
  .metier { margin-top: 12px; }
  .intro { text-align: center; margin: 30px auto 34px; }
  .offres { color: oklch(47% 0.005 60); margin-top: 12px; }
  nav { display: flex; justify-content: center; flex-wrap: wrap; column-gap: 30px; margin-top: 13px; }
  a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; display: inline-flex; align-items: center; min-height: 44px; }
  a span { margin-left: 5px; }
  a:hover { color: #7d4016; }
  a:focus-visible { outline: 2px solid #7d4016; outline-offset: 5px; }
  .pieces { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  picture { display: block; }
  picture img { width: 100%; height: auto; display: block; }
  footer { display: flex; justify-content: space-between; gap: 24px; margin-top: 36px; padding-top: 20px; border-top: 1px dashed oklch(72% 0.005 60); font-size: 11px; }
  address { font-style: normal; }
  footer p { text-align: right; }
  footer a { min-height: 44px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 699px) {
    :root { font-size: 14px; }
    main { padding: 42px 20px 20px; max-width: 480px; }
    h1 { width: min(76vw, 280px); }
    .metier { font-size: 12px; }
    .intro { margin: 26px auto 26px; }
    nav { column-gap: 20px; }
    .pieces { grid-template-columns: 1fr; gap: 28px; }
    footer { font-size: 12px; margin-top: 32px; flex-direction: column; gap: 16px; }
    footer p { text-align: left; }
  }
</style>
